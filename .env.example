# Copy to .env before docker compose. Local-only example password.
POSTGRES_USER=melissa
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=melissa
MIGRATION_DATABASE_URL=postgresql://melissa:local-development-only@localhost:5432/melissa?connection_limit=5&connect_timeout=3
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
MESSAGE_DEBOUNCE_MS=1500
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_INTEGRATION_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_RATE_LIMIT=300
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
DEMO_PASSWORD=

# Runtime must never use the migration owner. Local disposable password only.
RUNTIME_PASSWORD=local-runtime-only
DATABASE_URL=postgresql://melissa_runtime:local-runtime-only@localhost:5432/melissa?connection_limit=5&connect_timeout=3
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional locally; absent means random signing key per API process.
# JWT_SECRET=generate-at-least-48-random-characters
