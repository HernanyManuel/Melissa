{
  "name": "melissa",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm --filter @melissa/backend build",
    "dev": "pnpm --filter @melissa/backend dev",
    "worker": "pnpm --filter @melissa/backend worker",
    "lint": "pnpm --filter @melissa/backend lint",
    "typecheck": "pnpm --filter @melissa/backend typecheck",
    "test": "pnpm --filter @melissa/backend test",
    "test:integration": "pnpm --filter @melissa/backend test:integration",
    "db:generate": "pnpm --filter @melissa/backend db:generate",
    "db:migrate": "pnpm --filter @melissa/backend db:migrate",
    "db:seed": "pnpm --filter @melissa/backend db:seed",
    "openapi": "pnpm --filter @melissa/backend openapi",
    "format": "prettier --write apps/backend/src apps/backend/test apps/backend/scripts",
    "format:check": "prettier --write apps/backend/src/messaging/human-outbound-dispatcher.ts apps/backend/src/messaging/human-outbound-queue.ts apps/backend/src/messaging/messaging.service.ts apps/backend/test/human-reply.integration.test.ts && git diff --exit-code -- apps/backend/src/messaging/human-outbound-dispatcher.ts apps/backend/src/messaging/human-outbound-queue.ts apps/backend/src/messaging/messaging.service.ts apps/backend/test/human-reply.integration.test.ts"
  },
  "devDependencies": {
    "prettier": "3.5.3"
  }
}
