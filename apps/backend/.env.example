# Copy to .env before docker compose. Local-only example password.
POSTGRES_USER=melissa
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=melissa
DATABASE_URL=postgresql://melissa:local-development-only@localhost:5432/melissa?connection_limit=5&connect_timeout=3
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
