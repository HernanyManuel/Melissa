generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global bootstrap metadata only. Business data and RLS arrive in Phase 2.
model InfrastructureMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("infrastructure_metadata")
}

enum TenantRole {
  owner
  admin
  manager
  staff
  viewer
}

model User {
  termsVersion    String          @map("terms_version")
  termsAcceptedAt DateTime        @map("terms_accepted_at") @db.Timestamptz(6)
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  passwordHash    String          @map("password_hash")
  name            String
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions        Session[]
  tokens          IdentityToken[]
  memberships     Membership[]

  @@map("users")
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  hash      String    @id
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model IdentityToken {
  hash      String    @id
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  @@index([userId, purpose])
  @@map("identity_tokens")
}

model Tenant {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  countryCode        String               @map("country_code")
  timezone           String
  legalName          String?              @map("legal_name")
  industryKey        String?              @map("industry_key")
  city               String?
  address            String?
  website            String?
  locale             String               @default("pt")
  currency           String               @default("EUR")
  onboardingStep     Int                  @default(2) @map("onboarding_step")
  provisioningStatus String               @default("configuring") @map("provisioning_status")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships        Membership[]
  invitations        Invitation[]
  audit              AuditEvent[]
  services           BusinessService[]
  businessHours      BusinessHour[]
  scheduleExceptions ScheduleException[]
  faqs               Faq[]
  staff              Staff[]
  configuration      TenantConfiguration?

  @@map("tenants")
}

model IndustryTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  defaults    Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("industry_templates")
}

model BusinessService {
  id                  String         @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                String
  slug                String
  description         String?
  category            String?
  price               Decimal        @db.Decimal(20, 6)
  currency            String
  durationMinutes     Int            @map("duration_minutes")
  bufferBeforeMinutes Int            @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int            @default(0) @map("buffer_after_minutes")
  bookingEnabled      Boolean        @default(true) @map("booking_enabled")
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  staffServices       StaffService[]

  @@id([tenantId, id])
  @@unique([tenantId, slug])
  @@map("services")
}

model BusinessHour {
  id        String  @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  weekday   Int
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  enabled   Boolean @default(true)

  @@id([tenantId, id])
  @@index([tenantId, weekday])
  @@map("business_hours")
}

model ScheduleException {
  id        String   @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  date      DateTime @db.Date
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")
  closed    Boolean  @default(false)
  reason    String?

  @@id([tenantId, id])
  @@index([tenantId, date])
  @@map("schedule_exceptions")
}

model Faq {
  id        String   @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  question  String
  answer    String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@map("faqs")
}

model Staff {
  id        String         @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String?        @map("user_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  avatarUrl String?        @map("avatar_url")
  roleTitle String?        @map("role_title")
  active    Boolean        @default(true)
  timezone  String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  services  StaffService[]

  @@id([tenantId, id])
  @@map("staff")
}

model StaffService {
  tenantId              String          @map("tenant_id") @db.Uuid
  staffId               String          @map("staff_id") @db.Uuid
  serviceId             String          @map("service_id") @db.Uuid
  staff                 Staff           @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  service               BusinessService @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  customDurationMinutes Int?            @map("custom_duration_minutes")
  customPrice           Decimal?        @map("custom_price") @db.Decimal(20, 6)
  active                Boolean         @default(true)

  @@id([tenantId, staffId, serviceId])
  @@map("staff_services")
}

model TenantConfiguration {
  tenantId                String   @id @map("tenant_id") @db.Uuid
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cancellation            String?
  rescheduling            String?
  lateness                String?
  noShow                  String?  @map("no_show")
  payment                 String?
  refunds                 String?
  deposits                String?
  minimumAge              Int?     @map("minimum_age")
  otherRules              String?  @map("other_rules")
  tone                    String   @default("friendly")
  useEmojis               Boolean  @default(false) @map("use_emojis")
  useCustomerName         Boolean  @default(true) @map("use_customer_name")
  replyInCustomerLanguage Boolean  @default(true) @map("reply_in_customer_language")
  verbosity               String   @default("normal")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_configurations")
}

model Membership {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     TenantRole
  active   Boolean    @default(true)

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email      String
  role       TenantRole
  tokenHash  String     @unique @map("token_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@map("invitations")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("audit_events")
}
