{
  "name": "@melissa/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "worker": "tsx watch src/worker.ts",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test dist/test/unit.test.js",
    "test:integration": "pnpm build && node --test dist/test/integration.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "openapi": "pnpm build && node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.19.0",
    "bullmq": "5.56.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "pino": "9.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.49"
  },
  "devDependencies": {
    "@types/express": "5.0.2",
    "@types/node": "22.15.29",
    "eslint": "9.28.0",
    "prisma": "6.19.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0"
  }
}
